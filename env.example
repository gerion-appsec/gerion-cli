# Gerion CLI Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
GERION_API_URL=https://api.gerion.com
# Note: CLIENT_ID is automatically set to gerion-cli-{version} (e.g., gerion-cli-0.1.0)
# You can override it with GERION_CLIENT_ID if needed, but it's not recommended
# GERION_CLIENT_ID=gerion-cli-0.1.0
GERION_API_KEY=your-m2m-api-key-here 